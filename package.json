{
  "name": "findhouse",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "test": "npm run test --workspace=apps/web && npm run test:functions",
    "test:functions": "vitest run --root supabase/functions"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
